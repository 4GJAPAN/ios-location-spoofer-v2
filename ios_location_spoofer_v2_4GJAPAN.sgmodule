#!name=iOS Location Spoofer v2
#!desc=Persistent Apple network-location override with a local configuration page. Open http://location-spoofer.local/ after enabling the module.
#!homepage=https://github.com/4GJAPAN/ios-location-spoofer-v2

[Script]
iOS Location Spoofer Prepare = type=http-request,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$,requires-body=0,timeout=10,script-path=https://raw.githubusercontent.com/4GJAPAN/ios-location-spoofer-v2/main/location_spoofer_v2_fresh.js,argument=mode=prepare

iOS Location Spoofer Response = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/4GJAPAN/ios-location-spoofer-v2/main/location_spoofer_v2_fresh.js,argument=mode=response

iOS Location Spoofer Config = type=http-request,pattern=^http:\/\/location-spoofer\.local\/(?:$|status(?:\?.*)?$|set(?:\?.*)?$|enable(?:\?.*)?$|disable(?:\?.*)?$|reset(?:\?.*)?$|api\/config(?:\?.*)?$),requires-body=0,timeout=15,script-path=https://raw.githubusercontent.com/4GJAPAN/ios-location-spoofer-v2/main/location_spoofer_config_v2_fresh.js

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
